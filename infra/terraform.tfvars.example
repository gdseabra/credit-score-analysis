# Copie este arquivo para terraform.tfvars e preencha com seus valores:
#   cp terraform.tfvars.example terraform.tfvars

# ---- Databricks (serverless) ----

# URL do workspace (Databricks UI → top-left menu → Settings)
databricks_host = "https://adb-XXXXXXXXXXX.X.azuredatabricks.net"

# Token de acesso (Databricks UI → User Settings → Developer → Access Tokens)
databricks_token = "dapi..."

# true = cria job serverless agendado; false = destrói (use no fallback)
databricks_enabled = true

# Caminhos dos notebooks no workspace
databricks_notebook_etl_path   = "/Users/seu@email.com/credit-score-analysis/notebooks/01_etl_pipeline"
databricks_notebook_train_path = "/Users/seu@email.com/credit-score-analysis/notebooks/02_train_model"

# E-mail para alertas de falha nos jobs (deixe "" para desativar)
alert_email = "seu@email.com"
