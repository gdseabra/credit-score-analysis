# Copie este arquivo para terraform.tfvars e preencha com seus valores:
#   cp terraform.tfvars.example terraform.tfvars

# ---- Serving (Fase 1) ----

# Chave da API Anthropic (Claude) usada nas narrativas de explicação.
anthropic_api_key = "sk-ant-..."

# ---- Databricks (legado) ----
# Migração AWS-native: o retreino vai para Step Functions + Fargate na Fase 3.
# Mantenha false — os recursos Databricks serão removidos por completo na Fase 3.
databricks_enabled = false

# E-mail para alertas (deixe "" para desativar)
alert_email = "seu@email.com"
